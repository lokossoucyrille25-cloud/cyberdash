{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "index.html",
          "manifest.json",
          "sw.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/manifest.json",
      "dest": "api/index.py"
    },
    {
      "src": "/sw.js",
      "dest": "api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
